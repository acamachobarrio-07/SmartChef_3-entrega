      "name": "02 - Recetas - ID",
      "item": [
        {
          "name": "Id - Receta apta para todos los filtros",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Estado HTTP 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nconst datos = pm.response.json();\r\n\r\npm.test(\"Receta vegetariana\", function () {\r\n    pm.expect(datos.vegetariano).to.eql(true);\r\n});\r\n\r\npm.test(\"Receta sin gluten\", function () {\r\n    pm.expect(datos.sinGluten).to.eql(true);\r\n});\r\n\r\npm.test(\"Receta rápida\", function () {\r\n    pm.expect(datos.rapido).to.eql(true);\r\n});\r\n\r\npm.test(\"Receta económica\", function () {\r\n    pm.expect(datos.economico).to.eql(true);\r\n});\r\n\r\npm.test(\"Coste por ración correcto\", function () {\r\n    pm.expect(Number(datos.costePorRacion)).to.eql(0.56);\r\n});\r\n\r\npm.test(\"Contiene ingredientes\", function () {\r\n    pm.expect(datos.ingredientes.length).to.be.above(0);\r\n});\r\n\r\npm.test(\"Contiene pasos ordenados\", function () {\r\n    const numeros = datos.pasos.map(paso => paso.numero);\r\n\r\n    pm.expect(numeros).to.have.length.above(0);\r\n\r\n    numeros.forEach((numero, indice) => {\r\n        pm.expect(numero).to.eql(indice + 1);\r\n    });\r\n});"
                ]
              }
            }
          ],
