          "name": "Casos correctos (200)",
          "item": [
            {
              "name": "Buscar recetas con filtros",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": [
                      "\r\npm.test(\"Respuesta HTTP 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Las recetas cumplen tiempo y dificultad\", function () {\r\n    const respuesta = pm.response.json();\r\n\r\n    pm.expect(respuesta.content).to.be.an(\"array\");\r\n    pm.expect(respuesta.content.length).to.be.greaterThan(0);\r\n\r\n    respuesta.content.forEach(function (receta) {\r\n        pm.expect(receta.tiempo).to.be.at.most(30);\r\n        pm.expect(receta.dificultad).to.eql(\"FACIL\");\r\n    });\r\n});\r\n\r\npm.test(\"Paginación correcta\", function () {\r\n    const respuesta = pm.response.json();\r\n\r\n    pm.expect(respuesta.number).to.eql(0);\r\n    pm.expect(respuesta.size).to.eql(10);\r\n    pm.expect(respuesta.content.length).to.be.at.most(10);\r\n});\r\n"
                    ]
                  }
                }
              ],
